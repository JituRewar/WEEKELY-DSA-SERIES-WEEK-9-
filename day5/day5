    #include <iostream>
#include <queue>
#include <deque>
using namespace std;

int main() {

    // ================= QUEUE =================
    cout << "QUEUE Example\n";

    queue<int> q;

    // push elements
    q.push(10);
    q.push(20);
    q.push(30);

    cout << "Front element: " << q.front() << endl;
    cout << "Back element: " << q.back() << endl;

    // pop element
    q.pop();

    cout << "Front after pop: " << q.front() << endl;

    cout << "Queue elements: ";
    while(!q.empty()) {
        cout << q.front() << " ";
        q.pop();
    }
    cout << endl;


    // ================= DEQUE =================
    cout << "\nDEQUE Example\n";

    deque<int> dq;

    dq.push_back(10);
    dq.push_back(20);
    dq.push_front(5);
    dq.push_front(2);

    cout << "Front element: " << dq.front() << endl;
    cout << "Back element: " << dq.back() << endl;

    dq.pop_front();
    dq.pop_back();

    cout << "Deque elements: ";
    for(int x : dq) {
        cout << x << " ";
    }

    return 0;
}
